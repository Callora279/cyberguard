# ---- CyberGuard AI environment ----
# Copy to .env and fill in real values. .env is git-ignored — never commit it.
ENV=dev

# AI (Groq, OpenAI-compatible)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Data stores
DATABASE_URL=postgresql://cyberguard:cyberguard@db:5432/cyberguard
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=your_jwt_signing_secret_here
JWT_TTL_SECONDS=86400

# Chakra integration
CHAKRA_ORG_ID=your_chakra_org_id_here
INTERNAL_SYNC_SECRET=your_internal_sync_secret_here

# LiveGuard integration
LIVEGUARD_URL=https://liveguard.goiratech.com/api/errors

# Vulnerability feeds (public APIs; override only if you proxy them)
OSV_API_URL=https://api.osv.dev/v1/query
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0

# Outbound email for alert notifications (optional — leave blank to disable;
# alerts still land in the DB and Slack)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=alerts@cyberguard.ai

# Source-control / ticketing agents
GITHUB_TOKEN=your_github_token_here
GITLAB_TOKEN=your_gitlab_token_here
JIRA_URL=
JIRA_USER=
JIRA_TOKEN=your_jira_api_token_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_WEBHOOK_URL=

# Scan target for local runs
SCAN_TARGET_PATH=.
CYBERGUARD_STATE_DIR=.cyberguard
